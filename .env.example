# Copie este arquivo para .env e preencha (tudo é opcional).
#
# NÃO há mais ANTHROPIC_API_KEY: o agente usa o claude-agent-sdk, que roda o CLI
# `claude` por baixo e reaproveita o login da sua assinatura (a mesma do Claude
# Code Desktop). Pré-requisito:
#   npm install -g @anthropic-ai/claude-code
#   claude        # faça login uma vez
# Confira com: claude --version

# Opcional — modelo Claude a usar. Aceita alias ("sonnet", "opus") ou id completo.
AGENTE_QA_MODEL=sonnet

# Opcional — limites de segurança da execução (podem ser sobrescritos por --max-steps/--timeout).
AGENTE_QA_MAX_STEPS=40
AGENTE_QA_MAX_DURATION_SECONDS=600

# Opcional — caminho do prompt de sistema editável (padrão: prompts/system_prompt.md).
AGENTE_QA_PROMPT_PATH=prompts/system_prompt.md

# Opcional — pasta onde as execuções são gravadas (padrão: data/).
# AGENTE_QA_DATA_DIR=data

# Opcional — credenciais de login para um sistema-alvo específico.
# Use um nome de variável por teste, referenciado no arquivo YAML do teste (ver testes/exemplo.yaml).
# TEST_CCM_USER=
# TEST_CCM_PASS=
